{
  "databases": {
    "app": {
      "driver": "sqlite",
      "targets": {
        "local": {
          "transport": "local",
          "database": "application/storage/database.sqlite"
        },
        "development": {
          "transport": "ssh",
          "database": "/home/example/domains/example.com/dev/database.sqlite",
          "ssh": {
            "host": "example.com",
            "port": 22,
            "user": "deploy",
            "identity": ".rush/schema/ssh/deploy_ed25519",
            "php_binary": "/opt/alt/php83/usr/bin/php"
          }
        },
        "production": {
          "transport": "http",
          "url": "https://example.com/rush-schema-agent.php",
          "database": "/home/example/domains/example.com/database.sqlite",
          "token_file": ".rush/schema/tokens/production",
          "secure": true
        }
      }
    },
    "analytics": {
      "driver": "mysql",
      "targets": {
        "local": {
          "transport": "local",
          "database": "analytics",
          "host": "127.0.0.1",
          "port": 3306,
          "user": "root",
          "password": ""
        },
        "production": {
          "transport": "ssh",
          "database": "analytics",
          "host": "127.0.0.1",
          "port": 3306,
          "user": "analytics",
          "password": "secret",
          "ssh": {
            "host": "example.com",
            "port": 22,
            "user": "deploy",
            "identity": ".rush/schema/ssh/deploy_ed25519",
            "php_binary": "/opt/alt/php83/usr/bin/php"
          }
        }
      }
    }
  }
}
